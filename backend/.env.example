# Copy to backend/.env and adjust. All variables are prefixed with APPLIER_.
APPLIER_ENVIRONMENT=development
# PostgreSQL in production (SQLite is used by default for local development):
# APPLIER_DATABASE_URL=postgresql+psycopg://applier:applier@localhost:5432/applier

# REQUIRED in production — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
APPLIER_SECRET_KEY=change-me
# REQUIRED in production — generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# APPLIER_ENCRYPTION_KEY=

APPLIER_COOKIE_SECURE=false
APPLIER_FRONTEND_URL=http://localhost:3000
APPLIER_CORS_ORIGINS=["http://localhost:3000"]

# Demo mode: sample data + clearly-labelled demo job source when LinkedIn/Indeed aren't connected
APPLIER_DEMO_MODE=true

# Optional: AI-assisted writing (cover letters, bullet polish). Deterministic templates are used when unset.
# APPLIER_ANTHROPIC_API_KEY=

# Optional OAuth apps (integrations only appear as connectable when configured)
# APPLIER_GOOGLE_CLIENT_ID=
# APPLIER_GOOGLE_CLIENT_SECRET=
# APPLIER_MICROSOFT_CLIENT_ID=
# APPLIER_MICROSOFT_CLIENT_SECRET=
# APPLIER_LINKEDIN_CLIENT_ID=
# APPLIER_LINKEDIN_CLIENT_SECRET=
# APPLIER_INDEED_CLIENT_ID=
# APPLIER_INDEED_CLIENT_SECRET=

# Public employer ATS job boards to search (JSON). Board tokens are the company slugs used by each ATS.
# APPLIER_EMPLOYER_BOARDS={"greenhouse": ["examplecompany"], "lever": ["examplecompany"], "ashby": ["examplecompany"]}
